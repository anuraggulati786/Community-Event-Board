# ---------------------------------------------------------------------------
# Community Events Board - environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Any Postgres works: local, Docker, Neon, Supabase, RDS, ...
# The Docker command in the README uses exactly this value.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/community_events?schema=public"

# Secret used to sign visitor JWTs (HS256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Secret used to sign admin JWTs. Keep it different from JWT_SECRET.
ADMIN_JWT_SECRET="replace-with-a-different-long-random-string"

# The single hard-coded admin identity.
ADMIN_EMAIL="admin@community.com"
ADMIN_PASSWORD="admin123"

# How long issued tokens stay valid (seconds). 7 days.
SESSION_TTL_SECONDS="604800"
